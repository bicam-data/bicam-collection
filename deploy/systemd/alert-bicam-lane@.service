[Unit]
Description=BICAM lane failure alert for %i
# Started by OnFailure= from bicam-.service.d/10-lane-status.conf with the
# failed unit's full name as the instance.

[Service]
Type=oneshot
WorkingDirectory=%h/bicam/bicam-collection
ExecStart=%h/bicam/bicam-collection/.venv/bin/python %h/bicam/bicam-collection/scripts/alert_lane_failure.py --unit %i
