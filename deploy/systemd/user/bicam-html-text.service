[Unit]
Description=BICAM bounded Congress HTML text extraction
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/bicam/bicam-collection
ExecStart=%h/bicam/bicam-collection/.venv/bin/python scripts/run_html_text_lane.py
Environment=BICAM_HTML_BATCH_LIMIT=250
Environment=BICAM_HTML_MAX_BATCHES=2
Environment=BICAM_HTML_CONCURRENCY=12
# Below the observed Congress.gov 429 threshold.
Environment=BICAM_HTML_REQUEST_INTERVAL=0.5
# Congress.gov's unauthenticated HTML limiter is stricter than GovInfo's.
Environment=BICAM_HTML_CONGRESS_REQUEST_INTERVAL=1.0
Environment=BICAM_HTML_GOVINFO_REQUEST_INTERVAL=0.25
Environment=BICAM_HTML_REFRESH_DAYS=30
Environment=BICAM_HTML_RETRY_FAILED_DAYS=1
Environment=BICAM_HTML_REQUEST_TIMEOUT=12
# How long dbt propagation waits for the shared lock before deferring.
Environment=BICAM_HTML_LOCK_TIMEOUT_SECONDS=900
MemoryMax=1G
TasksMax=256
TimeoutStartSec=30m
KillMode=control-group
