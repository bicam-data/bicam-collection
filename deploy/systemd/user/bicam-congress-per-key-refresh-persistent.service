[Unit]
Description=Bicam bounded Congress descendant refresh (persistent)
After=docker.service

[Service]
Type=simple
WorkingDirectory=%h/bicam
ExecStart=%h/bicam/bicam-collection/ops/run_congress_per_key_ramp_v1.sh
Restart=on-failure
# The descendant runner yields after a bounded cursor slice so the historical
# queue can acquire the shared ingestion lock; restart it after the queue or
# another lane finishes its slice.
# The cursor exits successfully once all configured root partitions are
# complete.  Do not relaunch a no-op worker every minute; the six-hour
# incremental timer starts it again when new work is discovered.
Restart=on-failure
RestartSec=30s
MemoryMax=2G
TasksMax=512

[Install]
WantedBy=default.target
