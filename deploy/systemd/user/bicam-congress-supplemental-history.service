[Unit]
Description=Bicam missing Congress.gov endpoint-family historical backfill
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/bicam
ExecStart=%h/bicam/bicam-collection/ops/run_congress_supplemental_history.sh
TimeoutStartSec=24h
KillMode=control-group
MemoryMax=1G
TasksMax=512
Restart=on-failure
RestartSec=30min

[Install]
WantedBy=default.target
