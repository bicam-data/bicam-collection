[Unit]
Description=Bicam Congress and GovInfo ingestion supervisor
After=docker.service

[Service]
Type=simple
WorkingDirectory=%h/bicam
ExecStart=%h/bicam/bicam-collection/ops/run_bicam_ingestion_supervisor.sh
Restart=on-failure
RestartSec=30s
KillMode=control-group
TimeoutStopSec=60s

[Install]
WantedBy=default.target
