[Unit]
Description=Bicam stored Congress amendment descendant refresh
After=docker.service

[Service]
Type=simple
WorkingDirectory=%h/bicam/bicam-collection
ExecStart=%h/bicam/bicam-collection/ops/run_bicam_amendment_descendant_refresh.sh
Restart=on-failure
RestartSec=60s
KillMode=control-group
TimeoutStopSec=60s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
