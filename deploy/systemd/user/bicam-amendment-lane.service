[Unit]
Description=Bicam bounded amendment descendant lane
After=bicam-ingestion-supervisor.service

[Service]
Type=simple
WorkingDirectory=%h/bicam/bicam-collection
ExecStart=%h/bicam/bicam-collection/scripts/run_bicam_amendment_lane.sh
KillMode=control-group
Restart=no
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
