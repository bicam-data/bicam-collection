[Unit]
Description=Bicam historical Congress 1-119 partition queue
After=docker.service

[Service]
Type=simple
WorkingDirectory=%h/bicam
ExecStart=%h/bicam/bicam-collection/ops/run_congress_partition_queue.sh
Restart=on-failure
RestartSec=30s
MemoryMax=2G
TasksMax=512

[Install]
WantedBy=default.target
