[Unit]
Description=Bicam bounded amendment failure retry
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/bicam/bicam-collection
ExecStart=%h/bicam/bicam-collection/ops/run_bicam_amendment_retry_window.sh
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:%h/bicam/reports/amendment-retry-scheduled.log
StandardError=append:%h/bicam/reports/amendment-retry-scheduled.log
TimeoutStartSec=1800s

[Install]
WantedBy=default.target
