# Bicam Collection Environment Variables
# Copy this file to .env and update with your actual values

# Database Configuration
POSTGRESQL_HOST=lobbyview.mit.edu
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=lobbyview
POSTGRESQL_USERNAME=bicam_pipeline
POSTGRESQL_PASSWORD='B1C4M[pipe]!'

# API Keys
CONGRESSIONAL_API_KEY=your_congressional_api_key_here
GOVINFO_API_KEY=your_govinfo_api_key_here

# Environment Settings
ENVIRONMENT=development
DEBUG=false

# Scraping Configuration
SCRAPING_OUTPUT_DIR=/tmp/bicam-data
SCRAPING_MAX_CONCURRENT_REQUESTS=10
SCRAPING_REQUEST_TIMEOUT=30
SCRAPING_RETRY_ATTEMPTS=3
SCRAPING_RETRY_DELAY=1.0
SCRAPING_RATE_LIMIT_DELAY=0.1

# Processing Configuration
PROCESSING_CHUNK_SIZE=1000
PROCESSING_MAX_WORKERS=4
PROCESSING_TEMP_DIR=/tmp/bicam-processing
PROCESSING_MEMORY_LIMIT_GB=4.0
PROCESSING_ENABLE_PARALLEL=true

# Export Configuration
EXPORT_DIR=/tmp/bicam-exports
EXPORT_FORMATS=csv,parquet
EXPORT_COMPRESS=true

# Lobbyist Matching Configuration
LOBBYIST_SIMILARITY_THRESHOLD=0.8
LOBBYIST_BATCH_SIZE=1000
LOBBYIST_TIMEOUT_SECONDS=300
LOBBYIST_ENABLE_FUZZY_MATCHING=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_STRUCTURED=true
LOG_TO_CONSOLE=true 