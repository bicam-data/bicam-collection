CONGRESS_API_KEYS=replace-me,replace-me-too
# The API currently advertises 20,000 in its response headers, but the
# response exposes a token-level counter. This is independent from the
# optional local aggregate pacing/ETA setting below; neither setting means
# unrelated credentials share an account or quota.
BICAM_CONGRESS_PER_KEY_RATE_LIMIT=20000
BICAM_CONGRESS_GLOBAL_RATE_LIMIT=20000
BICAM_CONGRESS_RATE_WINDOW_SECONDS=3600
BICAM_CONGRESS_RATE_SAFETY=0.95
# Optional six-hour supplemental-refresh tuning. These affect only the
# systemd supplemental service; keep the values bounded by observed headers
# and coordinated-429 behavior.
BICAM_SUPPLEMENTAL_CONCURRENCY=8
BICAM_SUPPLEMENTAL_CATEGORY_WORKERS=2
BICAM_SUPPLEMENTAL_REQUEST_INTERVAL=0.20
BICAM_SUPPLEMENTAL_DESCENDANT_CONCURRENCY=4
BICAM_SUPPLEMENTAL_DESCENDANT_INTERVAL=0.5
# Persistent descendant slices yield the ingestion lock and resume from this
# cursor; systemd may override the slice count for a deployment.
BICAM_RAMP_MAX_BATCHES=1
BICAM_RAMP_CURSOR_PATH=/home/YOUR_USER/bicam/reports/congress-descendant-refresh-cursor.json
BICAM_PARTITION_BETWEEN_GROUP_SECONDS=5
GOVINFO_API_KEY=replace-me

# Optional bounded HTML rendition lane. Congress.gov links are public; GovInfo
# /htm links use the GOVINFO_API_KEY pool above. The batch runner is resumable
# and skips recently successful or failed URLs.
BICAM_HTML_BATCH_LIMIT=250
# The installed ten-minute timer uses two bounded rounds; reduce this for a
# lower-pressure deployment or when invoking the wrapper manually.
BICAM_HTML_MAX_BATCHES=2
BICAM_HTML_CONCURRENCY=12
# Fallback HTML pace; source-specific values below take precedence.
BICAM_HTML_REQUEST_INTERVAL=0.5
# Congress.gov's unauthenticated HTML limiter is stricter than GovInfo's.
BICAM_HTML_CONGRESS_REQUEST_INTERVAL=1.0
# GovInfo /htm requests use the configured rotated key pool.
BICAM_HTML_GOVINFO_REQUEST_INTERVAL=0.25
BICAM_HTML_REFRESH_DAYS=30
BICAM_HTML_RETRY_FAILED_DAYS=1
BICAM_HTML_REQUEST_TIMEOUT=12
# Pushover remains disabled until the operator explicitly supplies credentials
# and passes --notify-pushover to report_source_gap_queue.py.
# PUSHOVER_TOKEN=
# PUSHOVER_USER=

# The crawler, dbt, and the ops/ lanes (via host psql) all connect with these.
# The defaults target the compose database through its port forward; point
# DB_HOST/DB_PORT at an existing server to use that instead.
DB_HOST=localhost
DB_PORT=5433
DB_USER=admin
DB_PASSWORD=replace-me
DB_NAME=bicam_collection
DB_SCHEMA=public

# Host port for the compose Postgres (unused with an external server).
DB_PORT_FORWARD=5433

# Disposable Postgres for `make test-db` (the postgres-test compose profile).
# The storage integration tests read this only from the process environment,
# never from .env, so export it explicitly when running pytest by hand.
BICAM_TEST_DATABASE_URL=postgresql://admin:test-password@localhost:5434/bicam_collection_test

PG_MAX_CONNECTIONS=60
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=2GB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_WAL_SIZE=2GB
PG_MIN_WAL_SIZE=256MB
PG_MAX_WORKER_PROCESSES=8
PG_MAX_PARALLEL_WORKERS=2
PG_MAX_PARALLEL_WORKERS_PER_GATHER=1
PG_LOG_MIN_DURATION_STATEMENT=1000

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
